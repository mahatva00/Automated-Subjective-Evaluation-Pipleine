{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/intelligent-notebook-evaluator/annotation-coverage-1.0.0.schema.json",
  "title": "Annotation coverage sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": ["coverage_version", "document_id", "annotation_filename", "source_text_sha256", "text_length", "chunking", "policy", "chunks"],
  "properties": {
    "coverage_version": {"const": "1.0.0"},
    "document_id": {"type": "string", "minLength": 1},
    "annotation_filename": {"type": "string", "minLength": 1},
    "source_text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "text_length": {"type": "integer", "minimum": 1},
    "chunking": {"type": "object", "required": ["strategy", "max_chars"], "properties": {"strategy": {"type": "string"}, "max_chars": {"type": "integer", "minimum": 100}}, "additionalProperties": false},
    "policy": {"type": "string"},
    "chunks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["chunk_id", "start_char", "end_char", "page_numbers", "text_sha256", "text", "structure_status", "semantic_status", "structure_reviewer", "structure_review_date", "semantic_reviewer", "semantic_review_date", "review_notes"],
        "properties": {
          "chunk_id": {"type": "string", "minLength": 1},
          "start_char": {"type": "integer", "minimum": 0},
          "end_char": {"type": "integer", "minimum": 1},
          "page_numbers": {"type": "array", "items": {}},
          "text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "text": {"type": "string", "minLength": 1},
          "structure_status": {"enum": ["pending", "reviewed"]},
          "semantic_status": {"enum": ["pending", "reviewed"]},
          "structure_reviewer": {"type": "string"},
          "structure_review_date": {"type": "string"},
          "semantic_reviewer": {"type": "string"},
          "semantic_review_date": {"type": "string"},
          "review_notes": {"type": "string"}
        }
      }
    }
  }
}
